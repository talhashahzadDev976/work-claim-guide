# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing (Vitest, Playwright)
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
desktop.ini
*.pem
*.log
.eslintcache

# editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# hosting (Vercel, Cloudflare)
.vercel
.wrangler/
.dev.vars

# supabase (local CLI state)
supabase/.branches/
supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
